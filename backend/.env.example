# Required for backend model calls
HF_TOKEN=your_hugging_face_token_here

# Optional: primary generation model
HF_MODEL=tiiuae/falcon-7b-instruct

# Optional: comma-separated fallback model list
HF_MODEL_CANDIDATES=tiiuae/falcon-7b-instruct,HuggingFaceH4/zephyr-7b-alpha,mistralai/Mistral-7B-Instruct-v0.2,google/gemma-7b-it

# Optional: evaluation provider settings used by backend/eval/
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# RAGAS_EVAL_PROVIDER=
# RAGAS_EVAL_MODEL=
# RAGAS_EMBED_MODEL=
